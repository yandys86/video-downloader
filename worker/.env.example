# Copia a `.env` en el LXC y edita valores.
# IMPORTANTE: pydantic-settings NO strippa comentarios inline — cada var en su
# propia línea, sin `# comentario` al final del valor.

# Secreto compartido con el Next.js (header X-Worker-Secret).
# Genera con: openssl rand -hex 32
WORKER_SECRET=CAMBIAME_openssl_rand_hex_32

# Claude API para detectar highlights y reescribir guiones.
ANTHROPIC_API_KEY=sk-ant-api03-...
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Rutas de trabajo (crear con permisos del user shorts-worker).
WORKSPACE_DIR=/var/lib/shorts-worker
DB_PATH=/var/lib/shorts-worker/jobs.db

# Límites (uso público y gratis).
# MAX_INPUT_DURATION_SECONDS: máximo de duración del vídeo de entrada en segundos.
# 3600 = 60 min cubre casi cualquier podcast/entrevista. Subir a 7200 (2h) si necesitas más.
MAX_INPUT_DURATION_SECONDS=3600
MAX_HIGHLIGHTS_PER_JOB=5
# MAX_CONCURRENT_JOBS: renders simultáneos en el worker.
MAX_CONCURRENT_JOBS=2

# Whisper (modelo tiny/base/small/medium/large-v3 · compute int8/int8_float16/float16/float32).
WHISPER_MODEL=small
WHISPER_COMPUTE_TYPE=int8
# Vacío = autodetectar idioma (recomendado). Forzar solo si sabes que todos los
# vídeos vienen en el mismo idioma; forzar el idioma equivocado devuelve transcript vacío.
WHISPER_LANGUAGE=

# edge-tts default (el usuario puede overridar por request).
DEFAULT_TTS_VOICE=es-ES-AlvaroNeural
DEFAULT_TTS_RATE=+8%

# Pexels (opcional, para stock B-roll style).
PEXELS_API_KEY=

# Groq API (opcional pero muy recomendado, gratis con free tier).
# Se usa cuando las auto-captions de YouTube son basura (música, silencio).
# whisper-large-v3-turbo: mejor calidad que Whisper base y ~20x más rápido.
# Get key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=whisper-large-v3-turbo

# Watermark opcional. Vacío = sin watermark.
WATERMARK_TEXT=tuvideodown.com

# HTTP.
HOST=0.0.0.0
PORT=8000
