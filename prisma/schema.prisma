// Prisma schema para el sistema SaaS de tuvideodown.
// SQLite para MVP (fichero en /opt/video-downloader/prisma/app.db en prod).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── NextAuth (Auth.js v4) ──────────────────────────────────────────
// Tablas requeridas por @auth/prisma-adapter para OAuth (Google) y
// email/password. La tabla User además tiene nuestros campos SaaS.

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  // Password hash (bcrypt) solo si se registró con email/password
  passwordHash  String?
  // Rol: "user" | "admin". Admin tiene bypass de créditos y todo.
  role          String    @default("user")
  // Créditos actuales (denormalizado; verdad = suma de credit_ledger)
  credits       Int       @default(0)
  // Config personal para Reels premium (Fase 3). isPremium desbloquea:
  //   - Watermark propio (texto libre, no forzado a tuvideodown.com)
  //   - Watermark animado (se mueve por el reel, anti-piratería)
  // Se activa desde el panel /admin.
  isPremium     Boolean   @default(false)
  watermarkText String?
  watermarkAnim Boolean   @default(false)
  // Telegram bot integration (Fase 2)
  telegramChatId String?
  // Opt-in independientes por canal. Un user puede estar vinculado a Telegram
  // pero temporalmente no querer recibir por ahí.
  telegramNotifications Boolean @default(true)
  emailNotifications    Boolean @default(true)
  // Timestamps
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  creditLedger   CreditLedger[]
  purchases      Purchase[]

  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── SaaS: créditos y compras ───────────────────────────────────────

// Historial append-only de todas las transacciones de créditos.
// Balance real de un user = SUM(amount) WHERE userId=?
// (User.credits es cache denormalizado para lecturas rápidas.)
model CreditLedger {
  id        String   @id @default(cuid())
  userId    String
  amount    Int      // positivo = añadir, negativo = descontar
  reason    String   // "signup_bonus" | "purchase" | "reel_generate" | "admin_grant" | "refund"
  refId     String?  // job_id, purchase_id, o admin note
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// Compras completadas (Stripe / PayPal / cripto).
model Purchase {
  id             String   @id @default(cuid())
  userId         String
  provider       String   // "stripe" | "paypal" | "crypto"
  providerRefId  String   @unique // stripe_session_id / paypal_order_id / etc.
  amountCents    Int      // p.ej. 900 = 9.00 €
  currency       String   @default("EUR")
  credits        Int      // créditos añadidos
  status         String   // "pending" | "paid" | "failed" | "refunded"
  createdAt      DateTime @default(now())
  paidAt         DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// Códigos temporales para vincular cuenta de Telegram.
// User genera un código en /account, lo envía al bot como /start CODE,
// el webhook lo consume y asocia el chat_id con la cuenta.
model TelegramLinkCode {
  code      String   @id
  userId    String   @unique  // 1 código pendiente por user
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}
