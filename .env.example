# tuvideodown — variables de entorno de Next.js.
# Copia a .env.local (dev) o .env.production (prod) y ajusta.

# ── Info API (Instagram con cookies opcional) ─────────────────────────
YT_DLP_PATH=/usr/local/bin/yt-dlp
IG_COOKIES_PATH=/opt/video-downloader/cookies.txt

# ── Módulo /shorts (worker en Proxmox CT 222) ─────────────────────────
# URL interna del worker FastAPI (privada, no expuesta a internet).
SHORTS_WORKER_URL=http://192.168.1.222:8000
# Debe coincidir con WORKER_SECRET del worker (.env del CT 222).
SHORTS_WORKER_SECRET=CAMBIAME_openssl_rand_hex_32
