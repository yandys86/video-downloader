# tuvideodown — variables de entorno de Next.js.
# Copia a .env.local (dev) o .env.production (prod) y ajusta.

# ── Info API (Instagram con cookies opcional) ─────────────────────────
YT_DLP_PATH=/usr/local/bin/yt-dlp
IG_COOKIES_PATH=/opt/video-downloader/cookies.txt

# ── Módulo /shorts (worker en Proxmox CT 231) ─────────────────────────
# URL interna del worker FastAPI (privada, no expuesta a internet).
SHORTS_WORKER_URL=http://192.168.1.99:8000
# Debe coincidir con WORKER_SECRET del worker (.env del CT 231).
SHORTS_WORKER_SECRET=CAMBIAME_openssl_rand_hex_32

# ── SaaS Fase 1: auth + créditos + Stripe ───────────────────────────
# Prisma SQLite (path absoluto en producción).
DATABASE_URL=file:./prisma/app.db

# NextAuth: genera con `openssl rand -hex 32`. NEXTAUTH_URL es la URL pública.
NEXTAUTH_SECRET=CAMBIAME_openssl_rand_hex_32
NEXTAUTH_URL=https://tuvideodown.com

# Emails admin (coma-separado). El primer email al registrarse se marca role=admin.
ADMIN_EMAILS=yandys.alfonso86@gmail.com

# Créditos gratis al registro (freemium).
SIGNUP_BONUS_CREDITS=5

# Google OAuth. Créalo en https://console.cloud.google.com → APIs & Services → Credentials
# Authorized redirect URI: https://tuvideodown.com/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe. Créalo en https://dashboard.stripe.com/apikeys
# Webhook URL: https://tuvideodown.com/api/stripe/webhook → evento checkout.session.completed
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
